# Interactive Demo Mode & Payment Environment
# 'simulation' (local SQLite simulation, no money moved) or 'paypal_sandbox' (real PayPal Sandbox APIs)
PUNCHPAY_DEMO_MODE=true
PAYMENT_MODE=simulation

# PayPal Sandbox ONLY (preserved for future live PayPal Sandbox testing)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Merchant ID of the contractor's PayPal Sandbox Business account
PAYPAL_MERCHANT_ID=
# Webhook ID from PayPal Developer Dashboard -> Sandbox App -> Webhooks
PAYPAL_WEBHOOK_ID=

# App origin for return URLs, sessions, and encrypted server credentials
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=
PUNCHPAY_CREDENTIAL_ENCRYPTION_KEY=

# Inspection Provider Mode: 'demo' (prepared sample cases + guided checklist), 'gemini', or 'ollama'
AI_PROVIDER=demo
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b

# Optional Cloud AI Vision Providers (also configurable encrypted via Admin Settings UI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional Supabase Persistence (if omitted, PunchPay uses local SQLite in .data/punchpay.db)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
