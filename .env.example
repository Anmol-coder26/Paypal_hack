# PayPal Sandbox ONLY (never use live credentials in this prototype)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Merchant ID of the contractor's PayPal Sandbox Business account
PAYPAL_MERCHANT_ID=
# Webhook ID from PayPal Developer Dashboard -> Sandbox App -> Webhooks
PAYPAL_WEBHOOK_ID=

# App origin for return URLs and local sessions
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=

# AI Vision Provider (configure either Gemini or Anthropic Claude)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional Supabase Persistence (if omitted, PunchPay uses local SQLite in .data/punchpay.db)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
